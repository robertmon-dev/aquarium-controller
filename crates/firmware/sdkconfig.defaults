CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y

CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="../../../../../../crates/firmware/partitions.csv"

CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y

# The HTTP server runs on this task, and one picoserve connection is most of
# what it needs.
#
# Measured 2026-11-07 with uxTaskGetStackHighWaterMark at a 160 KiB stack:
#   idle                                     35 756 B used
#   high-water, GET /api/telemetry          134 604 B used
#   high-water, PUT + SSE + DELETE          138 620 B used
# The earlier 131 072 B sat below even the plain-GET figure, so the device
# panicked on its first connection every time. The old "~78 KiB per connection"
# note was a mid-flight sample, not a high-water mark - which is why the margin
# looked generous while being 2.7 % short.
#
# 163 840 B leaves 25 220 B over the measured peak and survived a full
# `make smoke`. Moving the server to its own thread with a PSRAM stack was
# tried on 2026-11-07 and panicked at task creation (double exception, stack
# pointer and PC inside the 0x3C PSRAM window, 0xa5a5a5a5 fill pattern in the
# registers) - see the spec before trying it again.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=163840

# Keep this on. It is what finally caught the bug: a hardware watchpoint on
# the end of the running task's stack, which turned a mystery abort deep in
# the Wi-Fi driver into a register dump naming `g_pm`. It costs one watchpoint
# and no runtime.
CONFIG_FREERTOS_WATCHPOINT_END_OF_STACK=y
CONFIG_LWIP_MAX_SOCKETS=16
# CONFIG_ESP_WIFI_STA_DISCONNECTED_PM_ENABLE=n was added in 554cf75 while
# chasing the crash and removed again once it was shown to make no
# difference. Power management was never the cause. Left at the default.
